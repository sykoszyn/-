# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Sin estas variables la app funciona igual, pero solo local.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Dirección donde publicás la versión web. Se usa para armar los links de invitación.
EXPO_PUBLIC_APP_URL=https://parejo.app
